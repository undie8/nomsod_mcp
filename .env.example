# Public Supervisor / ChatGPT MCP endpoint
NOMSOD_GATEWAY_HOST=0.0.0.0
NOMSOD_GATEWAY_PORT=3219
NOMSOD_PUBLIC_BASE_URL=https://nomsod.example.com

# OAuth owner authorization. Use a long random secret.
NOMSOD_OWNER_KEY=change-me-long-random-secret

# First-time device pairing. Use a separate random secret.
NOMSOD_PAIRING_TOKEN=change-me-separate-pairing-token

# Internal self-healing runtime ports. These bind only to localhost.
NOMSOD_RUNTIME_PORT_A=3220
NOMSOD_CONTROL_PORT=3221
NOMSOD_RUNTIME_PORT_B=3222
NOMSOD_RUNTIME_DRAIN_TIMEOUT_MS=300000

# Agent
NOMSOD_GATEWAY_WS=wss://nomsod.example.com/agent

# Optional friendly name. If omitted, the OS hostname is used.
NOMSOD_DEVICE_NAME=

# Optional test/portable identity location.
# Normal installs use ~/.nomsod-mcp/device.json.
NOMSOD_IDENTITY_PATH=

# Connection self-healing
NOMSOD_HEARTBEAT_MS=15000
NOMSOD_STALE_MS=45000
