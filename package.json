{
  "name": "nomsod-mcp",
  "version": "0.4.16",
  "private": true,
  "type": "module",
  "description": "Cross-platform multi-computer MCP gateway and agent for ChatGPT",
  "scripts": {
    "start": "tsx src/bootstrap/supervisor.ts",
    "agent": "tsx src/bootstrap/agent.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:built": "node dist/bootstrap/supervisor.js",
    "agent:built": "node dist/bootstrap/agent.js",
    "dev:supervisor": "tsx src/bootstrap/supervisor.ts",
    "dev:runtime": "tsx src/gateway/main.ts",
    "dev:agent": "tsx src/bootstrap/agent.ts",
    "runtime": "tsx src/gateway/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vitest": "^3.2.0",
    "@modelcontextprotocol/client": "^2.1.0"
  }
}
